# ==============================================================
# WalchandGPT — Environment Configuration Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ==============================================================

# ── Application ────────────────────────────────────────────────
APP_ENV=development
APP_NAME=WalchandGPT
APP_VERSION=1.0.0
DEBUG=true
LOG_LEVEL=INFO

# ── API Server ──────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000

# ── Database ────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://walchand:walchand_secret@localhost:5432/walchandgpt
SYNC_DATABASE_URL=postgresql://walchand:walchand_secret@localhost:5432/walchandgpt

POSTGRES_USER=walchand
POSTGRES_PASSWORD=walchand_secret
POSTGRES_DB=walchandgpt
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ── JWT Authentication ──────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ── LLM Provider ───────────────────────────────────────────────
# Options: openai | google | ollama | openai_compatible
LLM_PROVIDER=openai
MODEL_NAME=gpt-4o-mini

# OpenAI / OpenAI-compatible
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1

# Google Gemini
GOOGLE_API_KEY=AIza...

# Ollama / LM Studio
OLLAMA_BASE_URL=http://localhost:11434

# ── Embedding Model ─────────────────────────────────────────────
# Options: openai | google | ollama | huggingface
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# ── MCP Server ──────────────────────────────────────────────────
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8001
MCP_SERVER_URL=http://localhost:8001

# ── Redis ───────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── File Storage ────────────────────────────────────────────────
# Options: local | s3
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./storage/uploads

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET_NAME=walchandgpt-documents

# ── CORS ────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# ── Rate Limiting ───────────────────────────────────────────────
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# ── RAG Configuration ───────────────────────────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RETRIEVAL=5
SIMILARITY_THRESHOLD=0.3
MAX_CONTEXT_TOKENS=4000

# ── LangSmith Observability (optional) ─────────────────────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=walchandgpt

# ── Next.js Frontend ────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=WalchandGPT
